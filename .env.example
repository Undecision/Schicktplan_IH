# ==============================================================================
# Schichtbuch – zentrale Umgebungsvariablen (Vorlage)
# Kopieren nach .env und Werte anpassen. NIEMALS echte Secrets committen.
# ==============================================================================

# --- Allgemein ---
NODE_ENV=development
APP_NAME=Schichtbuch
APP_URL=https://schichtbuch.local
TZ=Europe/Berlin

# --- API (apps/api) ---
API_PORT=3000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api

# --- Datenbank (PostgreSQL 16) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=schichtbuch
POSTGRES_USER=schichtbuch
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://schichtbuch:change-me@postgres:5432/schichtbuch?schema=public

# --- Dateispeicher (MinIO / S3-kompatibel) ---
S3_ENDPOINT=minio
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_USE_SSL=false
S3_ACCESS_KEY=schichtbuch
S3_SECRET_KEY=change-me-too
S3_BUCKET=schichtbuch-anhaenge
S3_REGION=eu-central-1

# --- Auth (lokal + OIDC-ready) ---
AUTH_JWT_ACCESS_SECRET=change-me-access-secret
AUTH_JWT_REFRESH_SECRET=change-me-refresh-secret
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=7d
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MINUTES=15

# OIDC (Entra ID) – v1 deaktiviert, Adapter vorbereitet
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=

# Automatischer Seed beim Container-Start (Rollen, Stammdaten, Bootstrap-Admin).
# Für den ersten Deploy auf "true" setzen; danach kann es auf "false" bleiben
# (der Seed ist idempotent und überschreibt bestehende Passwörter NICHT).
SEED_ON_STARTUP=true

# Bootstrap-Administrator (Erst-Login). Wird beim Seed angelegt, falls die
# E-Mail noch nicht existiert. Nach dem ersten Login Passwort ändern und diese
# Werte aus der produktiven .env entfernen.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Admin-Password-123
BOOTSTRAP_ADMIN_NAME=Administrator

# --- CORS ---
CORS_ORIGIN=https://schichtbuch.local

# --- Logging ---
LOG_LEVEL=info

# --- Reverse Proxy / Caddy ---
CADDY_DOMAIN=schichtbuch.local
CADDY_EMAIL=admin@example.com

# --- Web (apps/web) ---
WEB_PORT=5173
VITE_API_BASE_URL=/api

# --- Benachrichtigungen (Phase 8.5) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=schichtbuch@example.com
TEAMS_WEBHOOK_ENABLED=false
TEAMS_WEBHOOK_URL=

# --- DSGVO / Backup ---
BACKUP_ENCRYPTION_KEY=change-me-backup-key
BACKUP_RETENTION_DAYS=30

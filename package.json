{
  "name": "schichtbuch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudbasiertes Instandhaltungsschichtbuch – Monorepo",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @schichtbuch/api dev",
    "dev:web": "pnpm --filter @schichtbuch/web dev",
    "prepare": "husky",
    "postinstall": "if [ -f packages/shared/tsconfig.json ]; then pnpm --filter @schichtbuch/shared build; fi"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@scarf/scarf",
      "unrs-resolver",
      "argon2"
    ]
  }
}

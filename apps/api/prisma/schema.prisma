// Schichtbuch – Prisma-Schema
//
// Konventionen (gelten für ALLE künftigen Modelle, siehe Bauplan §0):
//   - Primärschlüssel: `id String @id @default(uuid()) @db.Uuid`
//   - Zeitstempel:      `createdAt DateTime @default(now())` / `updatedAt DateTime @updatedAt`
//   - Soft-Delete:      `deletedAt DateTime?` (nullable, statt Hard-Delete für Referenzintegrität)
//   - Volltextsuche:    Für durchsuchbare Freitextfelder wird pro Modell (Phase 5) eine
//                        generierte `tsvector`-Spalte + GIN-Index per SQL-Migration ergänzt
//                        (Prisma modelliert `Unsupported("tsvector")`).
//
// Weitere Modelle folgen ab Phase 2 (Stammdaten) und Phase 3 (Schichtbucheinträge).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ---------------------------------------------------------------------------
// Phase 1 – Auth & RBAC
// ---------------------------------------------------------------------------

enum UserStatus {
  AKTIV
  DEAKTIVIERT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Anmeldename (eindeutig). Die E-Mail bleibt für Benachrichtigungen/DSGVO erhalten.
  username     String     @unique
  email        String     @unique
  name         String
  /// Nullable für SSO-Benutzer (OIDC/Entra ID, Phase 1.3) ohne lokales Passwort.
  passwordHash String?
  status       UserStatus @default(AKTIV)

  /// Brute-Force-/Lockout-Schutz (P1.2), gesteuert über AUTH_LOCKOUT_*-Env-Variablen.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles               UserRole[]
  /// Gewerk-Sichtbarkeit als zusätzliche Datenfilter-Dimension (keine Mandantentrennung).
  gewerkeSichtbarkeit Gewerk[]   @relation("UserGewerkeSichtbarkeit")

  erstellteEintraege      Schichtbucheintrag[] @relation("EintragErsteller")
  verantwortlicheEintraege Schichtbucheintrag[] @relation("EintragVerantwortlicher")
  kommentare              EintragKommentar[]
  hochgeladeneAnhaenge    Anhang[]
  verantwortlicheBerichte Schichtbericht[]     @relation("BerichtVerantwortlicher")
  freigegebeneBerichte    Schichtbericht[]     @relation("BerichtFreigeber")
  uebergebeneUebergaben   Schichtuebergabe[]   @relation("UebergabeUebergeber")
  uebernommeneUebergaben  Schichtuebergabe[]   @relation("UebergabeUebernehmer")
  erstellteAnweisungen    Arbeitsanweisung[]   @relation("AnweisungErsteller")
  anweisungsQuittungen    ArbeitsanweisungQuittung[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Administrator | Meister/Schichtleiter | Instandhalter | Leseberechtigte (siehe packages/shared Rolle-Enum).
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// z.B. "eintraege:create" – siehe packages/shared/src/permissions.ts (einzige Quelle der Wahrheit).
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Gewerk – Sichtbarkeitsdimension (P1.1) und Stammdatum (P2.1).
/// Startwerte: Elektrotechnik, Mechanik, Versorgung/Medien (siehe seed.ts).
model Gewerk {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  aktiv     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users     User[]               @relation("UserGewerkeSichtbarkeit")
  eintraege Schichtbucheintrag[]
  berichte  Schichtbericht[]
  uebergaben Schichtuebergabe[]
  arbeitsanweisungen Arbeitsanweisung[]

  @@map("gewerke")
}

// ---------------------------------------------------------------------------
// Phase 2 – Stammdaten
// ---------------------------------------------------------------------------

/// Fachbereich (P2.1). Startwerte: Druck, Beschichtung, Endfertigung,
/// Medienversorgung, Palettierung, Logistik.
model Fachbereich {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  aktiv     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eintraege        Schichtbucheintrag[]
  technischePlaetze TechnischerPlatz[]
  arbeitsanweisungen Arbeitsanweisung[]

  @@map("fachbereiche")
}

/// Technischer Platz (P2.1) – SAP-PM-Auswahlliste + Freitext.
/// `sapSyncFaehig` markiert Plätze, die mit SAP synchronisiert werden können
/// (Vorbereitung für Modul-/API-Schnittstelle, Phase 12).
model TechnischerPlatz {
  id            String    @id @default(uuid()) @db.Uuid
  bezeichnung   String
  code          String    @unique
  sapSyncFaehig Boolean   @default(false)
  aktiv         Boolean   @default(true)
  /// Optionale Zuordnung zu einem Fachbereich – dient der Vorbelegung im
  /// Eintragsformular (Fachbereich wählen → passende Plätze).
  fachbereichId String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  fachbereich Fachbereich? @relation(fields: [fachbereichId], references: [id])
  eintraege   Schichtbucheintrag[]

  @@index([fachbereichId])
  @@map("technische_plaetze")
}

/// Schlagwort (P2.1). Startwerte: Pneumatik, Hydraulik, SPS, Elektrik,
/// Mechanik, Sicherheit.
model Schlagwort {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  aktiv     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eintraege Schichtbucheintrag[] @relation("EintragSchlagwoerter")

  @@map("schlagwoerter")
}

/// Schicht-Definition (P2.1): Früh/Spät/Nacht mit Start-/Endzeit.
/// Zeiten als "HH:MM"-String (lokale Werkszeit, keine Zeitzone nötig).
model SchichtDefinition {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  startzeit String
  endzeit   String
  aktiv     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eintraege Schichtbucheintrag[]
  berichte  Schichtbericht[]
  uebergaben Schichtuebergabe[]
  arbeitsanweisungen Arbeitsanweisung[]

  @@map("schicht_definitionen")
}

// ---------------------------------------------------------------------------
// Phase 3 – Schichtbucheinträge
// ---------------------------------------------------------------------------

enum Prioritaet {
  NIEDRIG
  NORMAL
  HOCH
  KRITISCH
}

enum EintragStatus {
  OFFEN
  IN_BEARBEITUNG
  ERLEDIGT
  VERSCHOBEN
}

/// Schichtbucheintrag (P3.1). Freitext-Felder werden in Phase 5 mit einer
/// generierten tsvector-Spalte + GIN-Index für die Volltextsuche ergänzt.
enum EintragTyp {
  SCHICHTINFORMATION
  STOERUNG
}

model Schichtbucheintrag {
  id          String        @id @default(uuid()) @db.Uuid
  /// Formulartyp: Schichtinformation (Freitext) oder Störung (strukturiert).
  typ         EintragTyp    @default(SCHICHTINFORMATION)
  /// Zeitpunkt des Ereignisses (kombiniert Datum + Uhrzeit aus dem Lastenheft).
  zeitpunkt   DateTime
  prioritaet  Prioritaet    @default(NORMAL)
  status      EintragStatus @default(OFFEN)
  /// Anzeigetext (bei Störung = Spiegel des Störungs-Felds, damit Suche/Berichte
  /// unverändert funktionieren).
  beschreibung String
  /// Nur bei typ=STOERUNG befüllt.
  stoerung           String?
  ursache            String?
  korrekturmassnahme String?

  /// Genau ein SAP-IH-Auftrag pro Eintrag (v1: manuelles Referenzfeld mit Validierung).
  sapIhAuftrag     String?
  easyFlowTag      String?
  faelligkeitsdatum DateTime?

  /// Beginn/Ende der tatsächlichen Bearbeitung. Werden beim Statuswechsel
  /// automatisch vorbelegt (Beginn → IN_BEARBEITUNG, Ende → ERLEDIGT), sofern
  /// leer, und können manuell überschrieben werden. Die Dauer wird daraus abgeleitet.
  bearbeitungBeginn DateTime?
  bearbeitungEnde   DateTime?

  schichtId          String @db.Uuid
  gewerkId           String @db.Uuid
  fachbereichId      String @db.Uuid
  technischerPlatzId String @db.Uuid
  erstellerId        String @db.Uuid
  verantwortlicherId String? @db.Uuid

  schicht          SchichtDefinition @relation(fields: [schichtId], references: [id])
  gewerk           Gewerk            @relation(fields: [gewerkId], references: [id])
  fachbereich      Fachbereich       @relation(fields: [fachbereichId], references: [id])
  technischerPlatz TechnischerPlatz  @relation(fields: [technischerPlatzId], references: [id])
  ersteller        User              @relation("EintragErsteller", fields: [erstellerId], references: [id])
  verantwortlicher User?             @relation("EintragVerantwortlicher", fields: [verantwortlicherId], references: [id])
  schlagwoerter    Schlagwort[]      @relation("EintragSchlagwoerter")
  kommentare       EintragKommentar[]
  anhaenge         Anhang[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Volltextsuche (P5.1): generierte tsvector-Spalte über beschreibung (A),
  /// sapIhAuftrag/easyFlowTag (B). Wird ausschließlich per Migration (GENERATED
  /// ALWAYS AS … STORED) und GIN-Index gepflegt – daher als Unsupported markiert.
  suchVektor Unsupported("tsvector")?

  @@index([gewerkId])
  @@index([fachbereichId])
  @@index([technischerPlatzId])
  @@index([erstellerId])
  @@index([status])
  @@index([prioritaet])
  @@index([zeitpunkt])
  @@index([suchVektor], type: Gin)
  @@map("schichtbucheintraege")
}

/// Kommentar zu einem Eintrag (P3.1) – von Instandhaltern.
model EintragKommentar {
  id       String @id @default(uuid()) @db.Uuid
  eintragId String @db.Uuid
  autorId  String @db.Uuid
  text     String

  eintrag Schichtbucheintrag @relation(fields: [eintragId], references: [id], onDelete: Cascade)
  autor   User               @relation(fields: [autorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eintragId])
  @@map("eintrag_kommentare")
}

/// Dateianhang an einem Schichtbucheintrag (P4.1). Die Binärdaten liegen in
/// MinIO (S3); hier werden nur Metadaten und der Objekt-Key gehalten.
model Anhang {
  id             String @id @default(uuid()) @db.Uuid
  eintragId      String @db.Uuid
  hochgeladenVonId String @db.Uuid
  /// Ursprünglicher Dateiname (für Download/Anzeige).
  dateiname      String
  mime           String
  /// Dateigröße in Bytes.
  groesse        Int
  /// Objekt-Key im MinIO-Bucket (nicht öffentlich; Download nur RBAC-geschützt).
  objectKey      String @unique

  eintrag       Schichtbucheintrag @relation(fields: [eintragId], references: [id], onDelete: Cascade)
  hochgeladenVon User              @relation(fields: [hochgeladenVonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eintragId])
  @@map("anhaenge")
}

enum SchichtberichtStatus {
  ENTWURF
  FREIGEGEBEN
}

/// Automatischer Schichtbericht je Schicht/Gewerk/Tag (P7.1). Die Kennzahlen
/// (Anzahl Einträge, offene Punkte, abgeschlossene Arbeiten, besondere
/// Ereignisse) werden beim Lesen aus den Einträgen abgeleitet; hier liegen die
/// Metadaten und der Freigabe-Status.
model Schichtbericht {
  id                  String               @id @default(uuid()) @db.Uuid
  datum               DateTime             @db.Date
  schichtId           String               @db.Uuid
  gewerkId            String               @db.Uuid
  verantwortlicherId  String?              @db.Uuid
  status              SchichtberichtStatus @default(ENTWURF)
  /// Freitext für besondere Ereignisse/Hinweise der Schicht.
  besondereEreignisse String?
  freigegebenVonId    String?              @db.Uuid
  freigegebenAm       DateTime?

  schicht          SchichtDefinition @relation(fields: [schichtId], references: [id])
  gewerk           Gewerk            @relation(fields: [gewerkId], references: [id])
  verantwortlicher User?             @relation("BerichtVerantwortlicher", fields: [verantwortlicherId], references: [id])
  freigegebenVon   User?             @relation("BerichtFreigeber", fields: [freigegebenVonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([datum, schichtId, gewerkId])
  @@index([datum])
  @@map("schichtberichte")
}

enum UebergabeStatus {
  ENTWURF
  UEBERGEBEN
}

/// Digitale Schichtübergabe je Schicht/Gewerk/Tag (P8.1). Die aus offenen Daten
/// übernommenen Listen (offene Störungen, laufende Arbeiten) werden beim Lesen
/// aus den Einträgen abgeleitet; die Freitextfelder und der Übergabe-Status
/// liegen hier.
model Schichtuebergabe {
  id                   String          @id @default(uuid()) @db.Uuid
  datum                DateTime        @db.Date
  schichtId            String          @db.Uuid
  gewerkId             String          @db.Uuid
  status               UebergabeStatus @default(ENTWURF)
  besondereHinweise    String?
  sicherheitshinweise  String?
  freischaltungen      String?
  arbeitsgenehmigungen String?
  wichtigeTermine      String?
  uebergebenVonId      String?         @db.Uuid
  uebernommenVonId     String?         @db.Uuid
  uebergebenAm         DateTime?

  schicht        SchichtDefinition @relation(fields: [schichtId], references: [id])
  gewerk         Gewerk            @relation(fields: [gewerkId], references: [id])
  uebergebenVon  User?             @relation("UebergabeUebergeber", fields: [uebergebenVonId], references: [id])
  uebernommenVon User?             @relation("UebergabeUebernehmer", fields: [uebernommenVonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([datum, schichtId, gewerkId])
  @@index([datum])
  @@map("schichtuebergaben")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
}

/// Append-only Audit-Log (P1.6). DB-seitig gegen UPDATE/DELETE gesichert,
/// siehe Migration `..._audit_log_immutability` (Postgres RULE).
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  actorId   String?     @db.Uuid
  actorName String?
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_log")
}

/// Arbeitsanweisung (P: Meister-Hinweise). Meister/Schichtleiter stellen ihrem
/// Team unregelmäßig Hinweise bereit – als Freitext und/oder mit einem Anhang
/// (Foto/PDF). Ziel ist ein Gewerk und optional eine Schicht. Mitarbeiter
/// quittieren die Anweisung als gelesen (siehe ArbeitsanweisungQuittung).
model Arbeitsanweisung {
  id    String  @id @default(uuid()) @db.Uuid
  titel String
  /// Freitext-Inhalt (optional, wenn ein Anhang vorhanden ist).
  text  String?

  gewerkId String @db.Uuid
  gewerk   Gewerk @relation(fields: [gewerkId], references: [id])

  /// Optionaler Fachbereich (filter-/durchsuchbar).
  fachbereichId String?      @db.Uuid
  fachbereich   Fachbereich? @relation(fields: [fachbereichId], references: [id])

  /// Optionale Ziel-Schicht (nur informativer Kontext, keine Zugriffsbeschränkung).
  schichtId String?            @db.Uuid
  schicht   SchichtDefinition? @relation(fields: [schichtId], references: [id])

  erstellerId String @db.Uuid
  ersteller   User   @relation("AnweisungErsteller", fields: [erstellerId], references: [id])

  /// Einzelner Inline-Anhang in MinIO (optional). Metadaten für Anzeige/Download.
  anhangObjectKey String?
  anhangDateiname String?
  anhangMime      String?
  anhangGroesse   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quittungen ArbeitsanweisungQuittung[]

  @@index([gewerkId])
  @@index([fachbereichId])
  @@index([erstellerId])
  @@map("arbeitsanweisungen")
}

/// Lesequittung einer Arbeitsanweisung durch einen Mitarbeiter.
model ArbeitsanweisungQuittung {
  id String @id @default(uuid()) @db.Uuid

  arbeitsanweisungId String           @db.Uuid
  arbeitsanweisung   Arbeitsanweisung @relation(fields: [arbeitsanweisungId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  gelesenAm DateTime @default(now())

  @@unique([arbeitsanweisungId, userId])
  @@index([userId])
  @@map("arbeitsanweisung_quittungen")
}

/// Globale App-Einstellungen als Key-Value (P: konfigurierbare UI). Aktuell
/// genutzt für die Spalten-Reihenfolge der Schichtbuch-Tabelle. Bewusst generisch
/// gehalten, damit weitere Einstellungen ohne Schema-Änderung ergänzt werden können.
model AppEinstellung {
  key       String   @id
  wert      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_einstellungen")
}
